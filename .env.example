# =============================================================
#  Configuración de correo - Fer&Jos Inventory
# =============================================================
#  Copia este archivo como ".env"  y completa los valores.
#  Sin credenciales el sistema usa el backend de consola
#  (imprime el correo en la terminal, NO lo envía).
#
#  Con Gmail (recomendado):
#   1. Activa la Verificación en 2 pasos en tu cuenta Google.
#   2. Crea una "Contraseña de aplicaciones":
#      https://myaccount.google.com/apppasswords
#   3. Usa ese código de 16 caracteres como EMAIL_HOST_PASSWORD.
# =============================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Correo que ENVÍA los mensajes (tu cuenta Gmail):
EMAIL_HOST_USER=tu_correo@gmail.com
# Contraseña de aplicación de 16 caracteres (no la contraseña normal):
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# Cómo se ve el remitente. Deja vacío para usar "Fer&Jos Inventory <EMAIL_HOST_USER>":
DEFAULT_FROM_EMAIL=